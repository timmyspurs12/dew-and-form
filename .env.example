# Server-side only — NEVER prefix with NEXT_PUBLIC_
# Obtain an API key from https://yce.perfectcorp.com/api-console/en/api-keys/
YOUCAM_API_KEY=

# Optional server overrides (defaults match official Perfect Corp YouCam AI Skin Analysis v2.1 docs)
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com
YOUCAM_ANALYSIS_MODE=sd

# Optional conservative v2.1 action overrides (comma-separated, validated against official v2.1 enum; never mix SD & HD)
# Defaults:
#   SD -> skin_type,acne,oiliness
#   HD -> hd_skin_type,hd_acne,hd_oiliness
# YOUCAM_DST_ACTIONS=skin_type,acne,oiliness
# YOUCAM_HD_DST_ACTIONS=hd_skin_type,hd_acne,hd_oiliness

# Optional dedicated HMAC secret for signing session-bound task tokens (falls back to HKDF/SHA-256 of YOUCAM_API_KEY)
# YOUCAM_TASK_SIGNING_SECRET=

# Optional Open Beauty Facts base URL override for public cosmetic INCI registry (ODbL, no API key required)
# OPEN_BEAUTY_FACTS_BASE_URL=https://world.openbeautyfacts.org

# Optional server-side Optical Character Recognition (OCR) endpoint & key for automated INCI label photo extraction
# When omitted, Dew & Form Product Check validates uploaded label photos locally/server-side and provides an interactive zoom loupe for manual verification without fabricating OCR output.
# PRODUCT_LABEL_OCR_ENDPOINT=
# PRODUCT_LABEL_OCR_API_KEY=
